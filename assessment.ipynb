    {
      "cell_type": "code",
      "source": [
        "CHECKPOINT_FILE = \"checkpoint.json\"\n",
        "\n",
        "#load current checkpoint\n",
        "if os.path.exists(CHECKPOINT_FILE):\n",
        "    with open(CHECKPOINT_FILE, \"r\") as f:\n",
        "        results = json.load(f)\n",
        "    completed_ids = {r[\"qna_id\"] for r in results}\n",
        "    print(f\" Checkpoint found. Already completed: {len(completed_ids)}/{len(data)}\")\n",
        "else:\n",
        "    results = []\n",
        "    completed_ids = set()\n",
        "    print(\" No checkpoint found. Starting fresh.\")\n",
        "\n",
        "# This is main loop where models answer questions\n",
        "for i, item in enumerate(data):\n",
        "    qid = item[\"qna_id\"]\n",
        "\n",
        "    # skip questions that have been done\n",
        "    if qid in completed_ids:\n",
        "        print(f\"[{i+1}/{len(data)}], Skipping {qid} (already done)\")\n",
        "        continue\n",
        "\n",
        "    question  = item[\"question\"]\n",
        "    reference = item.get(\"answer\", \"\")\n",
        "    print(f\"[{i+1}/{len(data)}], Processing {qid}\")\n",
        "\n",
        "    # model generate answers\n",
        "    answer_groq   = ask_groq(question, qid)\n",
        "    answer_openai = ask_openai(question, qid)\n",
        "\n",
        "    # judge give scores\n",
        "    groq_scores   = judge_answer(question, reference, answer_groq,\n",
        "                                  qid, \"groq\")\n",
        "    openai_scores = judge_answer(question, reference, answer_openai,\n",
        "                                  qid, \"openai\")\n",
        "\n",
        "    # save result of current question\n",
        "    results.append({\n",
        "        \"qna_id\":            qid,\n",
        "        \"question\":          question,\n",
        "        \"reference_answer\":  reference,\n",
        "        \"categories\":        item.get(\"categories\"),\n",
        "        \"model_groq\":        \"llama-3.3-70b-versatile\",\n",
        "        \"model_groq_answer\": answer_groq,\n",
        "        \"groq_scores\":       groq_scores,\n",
        "        \"model_openai\":      \"gpt-4o-mini\",\n",
        "        \"model_openai_answer\": answer_openai,\n",
        "        \"openai_scores\":     openai_scores,\n",
        "    })\n",
        "\n",
        "    # write into checkpoint\n",
        "    with open(CHECKPOINT_FILE, \"w\") as f:\n",
        "        json.dump(results, f, indent=2, ensure_ascii=False)\n",
        "    print(f\"  Saved checkpoint ({len(results)}/{len(data)})\")\n",
        "    #avoid rate limit\n",
        "    time.sleep(1.5)\n",
        "\n",
        "print(\"\\n task finished!\")"
      ],
