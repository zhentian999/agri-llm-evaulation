    {
      "cell_type": "code",
      "source": [
        "#compare report\n",
        "rows=[]\n",
        "\n",
        "for item in results:\n",
        "  for model_key, score_key in [(\"model_groq\",\"groq_scores\"),(\"model_openai\", \"openai_scores\")]:\n",
        "    scores=item.get(score_key, {})\n",
        "    category=item.get(\"categories\",[\"unknown\"])[0]\n",
        "    rows.append({\"qna_id\": item[\"qna_id\"],\n",
        "                 \"model\": item[model_key],\n",
        "                 \"category\": category,\n",
        "                 \"accuracy\": scores.get(\"accuracy\"),\n",
        "                 \"relevance\": scores.get(\"relevance\"),\n",
        "                 \"completeness\": scores.get(\"completeness\"),\n",
        "                 \"conciseness\": scores.get(\"conciseness\"),\n",
        "                 \"interpretability\": scores.get(\"interpretability\")\n",
        "                 })\n",
        "df=pd.DataFrame(rows)\n",
        "\n",
        "df[\"overall\"]=df[[\"accuracy\",\"relevance\",\"completeness\",\"conciseness\",\"interpretability\"]].mean(axis=1)\n",
        "\n",
        "metrics=[\"accuracy\",\"relevance\",\"completeness\",\"conciseness\",\"interpretability\",\"overall\"]\n",
        "models=df[\"model\"].unique()\n",
        "colors={\"llama-3.3-70b-versatile\": \"pink\",\"gpt-4o-mini\":\"skyblue\"}\n"
      ],
      "metadata": {
        "id": "tmdPAwh8tEH5"
      },
      "execution_count": 40,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# 1.overall average\n",
        "overall = df.groupby(\"model\")[metrics].mean().round(2)\n",
        "print(\"Average Scores:\\n\", overall)\n",
        "\n",
        "# 2. which model is better\n",
        "diff = overall.loc[models[0]] - overall.loc[models[1]]\n",
        "for m in metrics:\n",
        "    print(f\"{m}: {models[0] if diff[m] > 0 else models[1]} wins\")\n",
        "\n",
        "# 3. groupby category\n",
        "cat_breakdown = df.groupby([\"category\",\"model\"])[\"overall\"].mean().round(2).unstack()\n",
        "print(\"\\nPer-category:\\n\", cat_breakdown)\n",
        "\n",
        "\n",
        "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
        "\n",
        "overall.T.plot(kind=\"bar\", ax=axes[0])\n",
        "axes[0].set_title(\"Overall Metrics\")\n",
        "\n",
        "\n",
        "cat_breakdown.plot(kind=\"bar\", ax=axes[1])\n",
        "axes[1].set_title(\"By Category\")\n",
        "\n",
        "\n",
        "overall.T.plot(ax=axes[2])\n",
        "axes[2].set_title(\"Metric Profile\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"report.png\")\n",
