    {
      "cell_type": "code",
      "source": [
        "#build function ask_openai\n",
        "def ask_openai(question,qid):\n",
        "    try:\n",
        "        response = openai_client.chat.completions.create(\n",
        "            model=\"gpt-4o-mini\",\n",
        "            messages=[{\"role\": \"system\", \"content\": \"You are an agricultural expert who gives precise, factual advice.\"},\n",
        "                {\"role\": \"user\", \"content\": question}\n",
        "            ],\n",
        "            temperature=0.6)\n",
        "        usage = response.usage\n",
        "        price = pricing[\"gpt-4o-mini\"]\n",
        "        cost  = usage.prompt_tokens * price[\"input\"] + usage.completion_tokens * price[\"output\"]\n",
        "        cost_log.append({\n",
        "            \"qna_id\":        qid,\n",
        "            \"model\":         \"gpt-4o-mini\",\n",
        "            \"call_type\":     \"answer\",\n",
        "            \"prompt_tokens\": usage.prompt_tokens,\n",
        "            \"output_tokens\": usage.completion_tokens,\n",
        "            \"cost_usd\":      round(cost, 6)\n",
        "        })\n",
        "        return response.choices[0].message.content\n",
        "    except Exception as e:\n",
        "        print(f\"openai error: {e}\")\n",
        "        return \"Error\"\n",
        "\n"
      ],
      "metadata": {
        "id": "c3li6pEQH3qO"
      },
      "execution_count": 25,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#use gpt-4o-mini as judge model\n",
        "def judge_answer(question, reference_answer, model_answer, qid, model_name):\n",
        "    prompt = f\"\"\"You are an expert agricultural evaluator. Score the model answer against the reference answer. Be critical and precise.\n",
        "\n",
        "QUESTION: {question}\n",
        "\n",
        "REFERENCE ANSWER: {reference_answer}\n",
        "\n",
        "MODEL ANSWER: {model_answer}\n",
        "\n",
        "Grade strictly using these criteria on a scale of 1-10:\n",
        "- accuracy (1-10): Penalize any factual errors or missing key facts vs reference. 10=perfect match, 5=partially correct, 1=wrong or missing major facts.\n",
        "- relevance (1-10): Penalize off-topic content. 10=fully on topic, 5=partially relevant, 1=misses the point.\n",
        "- completeness (1-10): Penalize missing points from the reference. 10=covers everything, 5=covers half, 1=barely covers anything.\n",
        "- conciseness (1-10): Penalize unnecessary filler or repetition. 10=tight and precise, 5=some padding, 1=very verbose or redundant.\n",
        "-interpretability (1-10): Can a non-expert farmer easily understand this answer? 10=clear plain language, no jargon, easy to follow for anyone, 5=mostly understandable but some technical terms or unclear phrasing,\n",
        "  1=heavy jargon, assumes expert knowledge, confusing for a typical farmer.\n",
        "\n",
        "Be critical. Most answers should score 6-8, not 10. Only give 10 if it truly matches the reference perfectly.\n",
        "\n",
        "Respond ONLY in this exact JSON format, no explanation, no markdown:\n",
        "{{\"accuracy\": <1-10>, \"relevance\": <1-10>, \"completeness\": <1-10>, \"conciseness\": <1-10>, \"interpretability\" :<1-10>}}\"\"\"\n",
        "\n",
        "    try:\n",
        "        response = openai_client.chat.completions.create(\n",
        "            model=\"gpt-4o-mini\",\n",
        "            messages=[{\"role\": \"user\", \"content\": prompt}],\n",
        "            temperature=0.0\n",
        "        )\n",
        "        usage = response.usage\n",
        "        price = pricing[\"gpt-4o-mini\"]\n",
        "        cost  = usage.prompt_tokens * price[\"input\"] + usage.completion_tokens * price[\"output\"]\n",
        "        cost_log.append({\n",
        "            \"qna_id\":        qid,\n",
        "            \"model\":         model_name,\n",
        "            \"call_type\":     \"judge\",\n",
        "            \"prompt_tokens\": usage.prompt_tokens,\n",
        "            \"output_tokens\": usage.completion_tokens,\n",
        "            \"cost_usd\":      round(cost, 6)\n",
        "        })\n",
        "        raw = response.choices[0].message.content.strip()\n",
        "        return json.loads(raw)\n",
        "    except Exception as e:\n",
        "        print(f\"Judge error: {e}\")\n",
        "        return {\"accuracy\": None, \"relevance\": None,\n",
        "                \"completeness\": None, \"conciseness\": None, \"interpretability\": None}"
      ],
      "metadata": {
        "id": "SwTRmVjWrZn8"
      },
      "execution_count": 26,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "with open('Agribench Task.json', 'r') as f:\n",
        "    data = json.load(f)\n",
        "\n",
        "results = []\n",
        "for i, item in enumerate(data):\n",
        "    qid = item[\"qna_id\"]\n",
        "    question = item[\"question\"]\n",
        "    print(f\"[{i+1}/20] Answering: {qid}\")\n",
        "\n",
        "    answer_groq = ask_groq(question, qid)\n",
        "    answer_openai = ask_openai(question, qid)\n",
        "    # avoid rate limit\n",
        "    time.sleep(1)\n",
        "\n",
        "    results.append({\n",
        "        \"qna_id\": qid,\n",
        "        \"question\": question,\n",
        "        \"reference_answer\": item.get(\"answer\"),\n",
        "        \"categories\": item.get(\"categories\"),\n",
        "        \"model_groq\": \"llama-3.3-70b-versatile\",\n",
        "        \"model_groq_answer\": answer_groq,\n",
        "        \"model_openai\": \"gpt-4o-mini\",\n",
        "        \"model_openai_answer\": answer_openai\n",
        "    })\n",
        "\n",
        "print(\"Answering complete.\")"
      ],
