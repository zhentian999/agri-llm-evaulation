    {
      "cell_type": "code",
      "source": [
        "#price per 1k tokens(usd)\n",
        "pricing={\"gpt-4o-mini\":           {\"input\": 0.000150/1000,  \"output\": 0.000600/1000},\n",
        "    \"llama-3.3-70b-versatile\": {\"input\": 0.0,           \"output\": 0.0}}\n",
        "cost_log=[]\n",
        "\n",
        "#build function ask_groq\n",
        "def ask_groq(question,qid):\n",
        "  try:\n",
        "    response=groq_client.chat.completions.create(\n",
        "      model=\"llama-3.3-70b-versatile\",\n",
        "      messages=[{\"role\": \"system\",\"content\":\"You are an agricultural expert who gives precise, factual advice.\"},\n",
        "              {\"role\": \"user\",\"content\":question}], temperature=0.6)\n",
        "    usage = response.usage\n",
        "    cost_log.append({\n",
        "            \"qna_id\":        qid,\n",
        "            \"model\":         \"llama-3.3-70b-versatile\",\n",
        "            \"call_type\":     \"answer\",\n",
        "            \"prompt_tokens\": usage.prompt_tokens,\n",
        "            \"output_tokens\": usage.completion_tokens,\n",
        "            \"cost_usd\":      0.0 })\n",
        "    return response.choices[0].message.content\n",
        "  except:\n",
        "    print(\"groq error,{e}\")\n",
        "    return \"Error\"\n"
      ],
      "metadata": {
        "id": "XT1HqIaqwkvW"
      },
      "execution_count": 24,
      "outputs": []
    },
